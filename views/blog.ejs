<!doctype html>
<html lang="en">

<head>
    <%- include('./partials/head') %>
</head>
<title>Blog</title>

<body>
    <%- include('./partials/nav') %>

        <div class="container mt-4">


            <h1>
                <%= blog.title %>
            </h1>
            <img src="<%= blog.coverImageURL %>" class="img-fluid rounded-start" width="700">

            <pre class="mt-4"><%= blog.body %></pre>
            <a href="/blog" class="btn btn-primary">Back</a>
        </div>

        <div class="container mt-4">
            <img src="<%= blog.createdBy.profileImageURL %>" class="img-fluid rounded-start" width="50">
            <%= blog.createdBy.fullName %>
        </div>

        <div class="container mt-4">
            <h5>Comments (<%= comments.length %>)</h5>
            <% if (locals.user) { %>
                <form action="/blog/comment/<%= blog._id %>" method="post">
                    <div class="mb-3">
                        <input type="text" class="form-control" id="content" name="content" aria-describedby="content"
                            placeholder="Add a comment" />
                    </div>
                    <button type="submit" class="btn btn-sm btn-primary">Add Comment</button>
                </form>
               
                <% } %>
                 <div class="container mt-4">
                    <% comments.forEach(comment=> { %>
                        <div class="card mt-4">
                            <div class="card-body">
                                <img src="<%= comment.createdBy.profileImageURL %>" class="img-fluid rounded-start"
                                    width="50">
                                <%= comment.createdBy.fullName %>
                                    <p class="card-text">
                                        <%= comment.content %>
                                    </p>
                            </div>
                        </div>
                        <% }) %>
                </div>
        </div>


        <%- include('./partials/scripts') %>

</body>

</html>